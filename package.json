{
  "name": "webapp",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch & node --watch dist/index.js",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "db:migrate:local": "mysql --default-character-set=utf8mb4 -h 127.0.0.1 -u $DB_USER -p$DB_PASSWORD $DB_NAME < migrations/mysql/0001_initial_schema.sql && mysql --default-character-set=utf8mb4 -h 127.0.0.1 -u $DB_USER -p$DB_PASSWORD $DB_NAME < migrations/mysql/0002_views_saldo.sql",
    "db:seed": "mysql --default-character-set=utf8mb4 -h 127.0.0.1 -u $DB_USER -p$DB_PASSWORD $DB_NAME < migrations/mysql/seed.sql",
    "db:console:local": "mysql --default-character-set=utf8mb4 -h 127.0.0.1 -u $DB_USER -p$DB_PASSWORD $DB_NAME"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@hono/node-server": "^2.1.5",
    "dotenv": "^16.6.1",
    "hono": "^4.13.13",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.6.3"
  }
}
