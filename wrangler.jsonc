{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nfp-gestao",
  "compatibility_date": "2026-04-26",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nfp-gestao-production",
      "database_id": "local-placeholder-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "nfp-gestao-arquivos"
    }
  ]
}
