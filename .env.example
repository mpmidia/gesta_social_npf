# Porta HTTP (Hostinger define automaticamente via process.env.PORT, mas
# localmente defina conforme desejar)
PORT=3000

# MySQL (Hostinger: hPanel > Bancos de Dados > Gerenciar)
# IMPORTANTE: use 127.0.0.1, NUNCA "localhost" (Node 17+ resolve localhost
# para ::1/IPv6, que o MySQL da Hostinger não aceita)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Segredo para assinatura de JWT (gerar um valor aleatório forte em produção)
JWT_SECRET=

# Cloudflare R2 (API compatível com S3) — usado como armazenamento de
# arquivos (comprovantes financeiros, galeria de projetos), pois o disco
# local da Hostinger é apagado a cada deploy.
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
